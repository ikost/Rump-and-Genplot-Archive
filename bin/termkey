#############################################################################
# Termkey source file	1.1           9/21/96
# Larry Doolittle, Newport News, VA
# Michael Thompson, Ithaca, NY
#
# This file describes key conversions for various terminals, as needed 
# by GENPLOT.
#
# CONVENTIONS: 
#   o First entry is the canonical form.  
#   o Second entry is the one the editor will use with "set" command.
#   o Last entry is verbose description. 
#
# NOTES:
#   o Names are searched sequentially in this file, so first recognized 
#     will be used.
#   o Comments in this file begin with #, or are entirely blank.  Comments 
#     may not appear in the middle of a termkey entry.
#
# WARNINGS:
#   o Redirection is not allowed.  Each entry must be complete itself.
#   o Code does minimal tests on the file.  Assumes it is valid format.
#
# Recognized keynames:
#
## Init and exit setup strings
#    setup   exit
## Since setup and exit strings are also sent for any shell push/return,
## the strings should not clear the screen.  This default behavior has
## been removed from the xterm and vt300 settings.
#
## Cursor and entry keys
#  bs   tab  esc    space  nl    del   ins     comma
#  left up   right  down   pgup  pgdn  pageup  pagedown
#  end  home  
#  ctrlleft ctrlright ctrlup   ctrldown
#  ctrlins  ctrldel   ctrlpgup ctrlpgdn
#  ctrlend  ctrlhome
#
## Control keys
#  break  backtab  scrolllock  printscreen  numlock  enter
#  sysreq
#
## Function keys
#  F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12
#
## Virtual button keys
#  b1 b2 b3
#   
# Terminal types needed by CONVEX: vt100 vt102 vt220 4105d tek4107 hp2648a
#                                  ansi  z19   z29a  ansi
#############################################################################
vt320|Dec VT320 terminal:\
	:esc=\E:bs=\x7F:del=\b:ins=\E[2~:\
	:home=\E[1~:end=\E[4~:pgup=\E[5~:pgdn=\E[6~:\
	:up=\E[A:down=\E[B:right=\E[C:left=\E[D:\
	:F1=\E[[A:F2=\E[[B:F3=\E[[C:F4=\E[[D:F5=\E[[E:F6=\E[17~:\
	:F7=\E[18~:F8=\E[19~:F9=\E[20~:F10=\E[21~:F11=\E[28~:F12=\E[29~:

# xterm home=\E[D (same as left)
xterm|vs100|AIX xterminal:\
	:esc=\E:bs=\b:del=\x7F:ins=\E[2z:\
	:pgup=\E[5z:pgdn=\E[6z:end=\E[\0:\
	:up=\E[A:down=\E[B:right=\E[C:left=\E[D:\
	:F1=\E[224z:F2=\E[225z:F3=\E[226z:F4=\E[227z:F5=\E[228z:F6=\E[229z:\
	:F7=\E[230z:F8=\E[231z:F9=\E[232z:F10=\E[233z:F11=\E[192z:F12=\E[193z:

# xterm home=\E[D (same as left)
xterm-color|vs100|Standard XTERM xterminal:\
	:esc=\E:bs=\b:del=\x7F:ins=\E[2z:\
	:pgup=\E[5z:pgdn=\E[6z:end=\E[\0:\
	:up=\E[A:down=\E[B:right=\E[C:left=\E[D:\
	:F1=\E[224z:F2=\E[225z:F3=\E[226z:F4=\E[227z:F5=\E[228z:F6=\E[229z:\
	:F7=\E[230z:F8=\E[231z:F9=\E[232z:F10=\E[233z:F11=\E[192z:F12=\E[193z:

# vt100
vt100|vt132|Dec VT100 terminal:\
	:esc=\E:bs=\b:del=\x7F:\
	:up=\E[A:down=\E[B:right=\E[C:left=\E[D:\
	:F1=\E[P:F2=\E[Q:F3=\E[R:F4=\E[S:F5=\E[T:\
	:F6=\E[U:F7=\E[V:F8=\E[W:F9=\E[E:F10=\E[F:\
	:up=\EOA:down=\EOB:right=\EOC:left=\EOD:\
	:del=\EOn:ins=\EOp:end=\EOq:down=\EOr:pagedown=\EOs:\
	:left=\EOt:up=\EOu:right=\EOv:home=\EOw:up=\EOx:\
	:pageup=\EOy:nl=\EOM:comma=\EOl:\
	:F1=\EOP:F2=\EOQ:F3=\EOR:F4=\EOS:

#vt220
vt220|vt340|Dec VT220 terminal:\
	:esc=\E:bs=\b:del=\x7F:\
	:del=\EOn:ins=\EOp:\
	:up=\E[A:down=\E[B:right=\E[C:left=\E[D:\
	:F1=\E[P:F2=\E[Q:F3=\E[R:F4=\E[S:F5=\E[T:\
	:F6=\E[U:F7=\E[V:F8=\E[W:F9=\E[E:F10=\E[F:\
	:up=\EOA:down=\EOB:right=\EOC:left=\EOD:\
	:end=\EOq:down=\EOr:pagedown=\EOs:\
	:left=\EOt:up=\EOu:right=\EOv:home=\EOw:up=\EOx:\
	:pageup=\EOy:nl=\EOM:comma=\EOl:\
	:F1=\EOP:F2=\EOQ:F3=\EOR:F4=\EOS:\
	:F6=\E[17~:F7=\E[18~:F8=\E[19~:F9=\E[20~:F10=\E[21~:

#
# END OF TERMKEY
#  ------------------------

