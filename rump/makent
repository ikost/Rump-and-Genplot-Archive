#
#   Makefile for RUMP
#

include ../makent.h

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
EXEFILE = $(EXEDIR)rump.exe

!ifdef DLL
OBJDIR  = .\odl.nt\ 
LIBFILE = $(LIBDIR)rumpdll.lib 
EXELIBS = $(DLLDIR)rumpsupp.lib $(DLLDIR)gensupp.lib $(DLLDIR)g_posix.lib
SYSLIBS = advapi32.lib wsock32.lib ole32.lib
DLLFILE = $(DLLDIR)rumpsupp.dll
DLLLIBS = $(LIBFILE) $(DLLDIR)gensupp.lib $(DLLDIR)g_posix.lib
!else
OBJDIR  = .\obj.nt\ 
LIBFILE = $(LIBDIR)rump.lib
EXELIBS = $(LIBFILE) $(LIBDIR)genplot.lib $(LIBDIR)tplot.lib $(LIBDIR)lexp.lib $(LIBDIR)sys.lib $(LIBDIR)g_posix.lib
SYSLIBS = user32.lib gdi32.lib advapi32.lib wsock32.lib ole32.lib
DLLFILE =
DLLLIBS =
!endif

ADTFILES  = $(EXEDIR)oxy.adt      $(EXEDIR)car.adt     $(EXEDIR)si.adt \
            $(EXEDIR)boron.adt    $(EXEDIR)carbon.adt  $(EXEDIR)fluorine.adt \
            $(EXEDIR)nitrogen.adt $(EXEDIR)oxygen.adt  $(EXEDIR)silicon.adt
STOPFILES = $(EXEDIR)he4_35.stp   $(EXEDIR)h_35.stp    $(EXEDIR)d_35.stp

SUPPORTFILES = $(EXEDIR)atom4.dat  $(EXEDIR)pscoef.dat \
               $(EXEDIR)rump.bat   $(EXEDIR)rump.ini   \
               $(STOPFILES) $(ADTFILES)

PATH3 = \"$(RUMPCONFIGPATH)\"
PATH4 = $(PATH3:\=\\)
RUMPPATHS = -DRUMPCONFIGPATH="$(PATH4:\\"=\")"

###########################################################################
MAIN   = $(OBJDIR)main.obj
SERIAL = serial.c
OBJS   = $(OBJDIR)rump.obj     $(OBJDIR)config.obj  \
         $(OBJDIR)aplot.obj    $(OBJDIR)bmanip.obj   $(OBJDIR)null.obj   \
         $(OBJDIR)rdwr.obj     $(OBJDIR)tplot.obj    $(OBJDIR)atomdo.obj \
         $(OBJDIR)anlytc.obj   $(OBJDIR)rbs_rdwr.obj $(OBJDIR)pert.obj   \
         $(OBJDIR)atomio.obj   $(OBJDIR)rdwr_old.obj $(OBJDIR)stopfoil.obj \
         $(OBJDIR)sim2.obj     $(OBJDIR)creatr.obj   $(OBJDIR)anlyz.obj  \
         $(OBJDIR)stopp.obj    $(OBJDIR)ziegler.obj  $(OBJDIR)reswork.obj \
         $(OBJDIR)stopping.obj $(OBJDIR)xrumphlp.obj $(OBJDIR)sigma.obj

ICON   = rump_nt.ico
###########################################################################
RUMP: $(LIBFILE) $(DLLFILE) $(SUPPORTFILES) $(EXEFILE)

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(LIBFILE) : $(OBJS)
	if EXIST $@ del $@
	..\genplot\nt_revtime RumpRevisionDate > revision.h
	$(CC) $(CFLAGS) -c -Foserial.obj $(SERIAL)
	$(LIBMGR) /out:$@ $** serial.obj
	del serial.obj

!ifdef DLL
$(MAIN) : main.c
	$(CC) $(EXEFLAGS) -c -Fo$@ main.c

$(EXEFILE) : $(MAIN) $(EXELIBS) $(OBJDIR)main_nt.res
	$(CC) $(EXEFLAGS) -Fe$@ $** $(SYSLIBS) $(DBGLIBS)
	$(_VC_EMBED_MANIFEST)
!else
$(EXEFILE) : $(MAIN) $(EXELIBS) $(OBJDIR)main_nt.res
 	$(CC) $(CFLAGS) $(RUMPPATHS) -Fe$@ $** $(SYSLIBS) $(DBGLIBS)
!endif


$(DLLDIR)rumpsupp.dll : $(DLLLIBS) $(SERIAL) rumpsupnt.def 
	..\genplot\nt_revtime RumpRevisionDate > revision.h
	$(CC) $(CFLAGS) -c -Foserial.obj $(SERIAL)
	$(CC) $(CFLAGS) $(RUMPPATHS) -Fe$@ $** $(SYSLIBS)
	del serial.obj

$(OBJDIR)main_nt.res : main_nt.rc $(ICON)
	$(RC) -r -fo $(OBJDIR)main_nt.res main_nt.rc

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
RUMP_H = rump.h spectrum.h rumpdata.h rumpproto.h rkeys.h
TPLOT  = $(INCDIR)tplot.h

$(OBJS) : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
