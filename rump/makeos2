$(OBJDIR)sigma.obf    : $(RUMP_H)                                                        sigma.h
$(OBJDIR)main.obj     : $(RUMP_H) $(TPLOT)
$(OBJDIR)null.obj     : $(RUMP_H)                                       xsect.h
$(OBJDIR)pert.obj     : $(RUMP_H)                     sample.h                   pert.h
$(OBJDIR)rdwr.obj     : $(RUMP_H)
$(OBJDIR)reswork.obj  : $(RUMP_H)                                       xsect.h
$(OBJDIR)rump.obj     : $(RUMP_H) $(TPLOT)
$(OBJDIR)sim2.obj     : $(RUMP_H)                     sample.h
$(OBJDIR)stopfoil.obj : $(RUMP_H)                     sample.h
$(OBJDIR)stopp.obj    : $(RUMP_H)          stopping.h 
$(OBJDIR)stopping.obj : $(RUMP_H)          stopping.h
$(OBJDIR)tplot.obj    : $(RUMP_H) $(TPLOT)
$(OBJDIR)xrumphlp.obj : $(RUMP_H) xrumphlp.h
$(OBJDIR)ziegler.obj  : $(RUMP_H)

$(OBJDIR)rbs_rdwr.obj : spectrum.h
$(OBJDIR)rdwr_old.obj : spectrum.h
$(OBJDIR)ndtr.obj     : ../lexp/gvdefs.h
$(OBJDIR)pert.obj     : ../genplot/curfit.h
