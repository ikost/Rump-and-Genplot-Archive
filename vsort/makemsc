#
#   Makefile for VSORT
#

include "../makemsc.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
OBJDIR = .\obj16\ 

OEXT = o

# Redefine LIBS so only posix linked
LIBS    = $(LIBDIR)posix.lib

###########################################################################
OBJS   = $(OBJDIR)vsort.$(OEXT)     $(OBJDIR)io_chan.$(OEXT)  \
         $(OBJDIR)laserjet.$(OEXT)  $(OBJDIR)deskjet.$(OEXT)  \
         $(OBJDIR)paintjet.$(OEXT)  $(OBJDIR)quietjet.$(OEXT) \
	 $(OBJDIR)okidata.$(OEXT)                             \
         $(OBJDIR)epson.$(OEXT)     $(OBJDIR)pin24.$(OEXT)
###########################################################################
ALL:	 $(DRVDIR)vsort.run

io_chan.h : ..\COMPLOT\io_chan.h
	cp $** $@

io_chan.c : ..\COMPLOT\io_chan.c
	cp $** $@

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(DRVDIR)vsort.run : $(OBJS) $(LIBS)
	   $(CC) $(COPTS) -Fe$@ $**

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS) : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
          io_chan.h vsort.h xtrn.h
