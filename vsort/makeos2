#
#   Makefile for VSORT
#

include "../makeos2.h"

# Add to options to force full linking and executables
MYOPTS = -Ge+ -Gd-

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#

# Redefine LIBS so only posix linked
!ifdef DLL
OBJDIR  = .\odl.os2\ 
EXELIBS = $(DLLDIR)g_posix.lib $(DLLDIR)gensupp.lib
SYSLIBS = -B"/NOD" CPPOM30O.LIB OS2386.LIB
!else
OBJDIR  = .\obj.os2\ 
EXELIBS = $(LIBDIR)g_posix.lib $(LIBDIR)sys.lib
SYSLIBS = 
!endif

# Modify the make expression
.c{$(ODLDIR)}.obj:
	$(CC) $(CFLAGS) $(MYOPTS) -C+ -Fo$@ $<

###########################################################################
OBJS   = $(OBJDIR)vsort.obj     $(OBJDIR)io_chan.obj	$(OBJDIR)support.obj \
         $(OBJDIR)laserjet.obj  $(OBJDIR)ljet4.obj	\
         $(OBJDIR)deskjet.obj	$(OBJDIR)deskjetc.obj	\
         $(OBJDIR)paintjet.obj  $(OBJDIR)quietjet.obj	\
	 $(OBJDIR)okidata.obj	$(OBJDIR)tiff.obj	\
         $(OBJDIR)epson.obj     $(OBJDIR)pin24.obj
###########################################################################
ALL:	 $(DRVDIR)vsort.run

io_chan.h : ..\COMPLOT\io_chan.h
	cp $** $@
	touch $@

io_chan.c : ..\COMPLOT\io_chan.c
	cp $** $@
	touch $@

drvclass.h : ..\COMPLOT\drvclass.h
	cp $** $@
	touch $@

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(DRVDIR)vsort.run : $(OBJS) $(EXELIBS)
	   $(CC) $(CFLAGS) $(MYOPTS) -Fe$@ $** $(SYSLIBS)

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS) : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
         io_chan.h vsort.h xtrn.h drvclass.h

$(OBJDIR)tiff.obj : tiff.h
