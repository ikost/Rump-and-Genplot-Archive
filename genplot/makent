#
#   Makefile for GENPLOT
#

include ../makent.h

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
EXEFILE = $(EXEDIR)genplot.exe
INI1_FILE = $(EXEDIR)genplot.ini
INI2_FILE = $(EXEDIR)genplot_.ini
DEVFILE   = $(EXEDIR)devices.dat
TERMKEYFILE = $(EXEDIR)termkey
PALETTEFILE = $(EXEDIR)default.pal
SUPPORT_FILES = $(INI1_FILE) $(INI2_FILE) $(DEVFILE) $(TERMKEYFILE) $(PALETTEFILE)

!ifdef DLL
OBJDIR  = .\odl.nt\ 
LIBFILE = $(LIBDIR)gendll.lib 
EXELIBS = $(DLLDIR)gensupp.lib $(DLLDIR)g_posix.lib
SYSLIBS = user32.lib gdi32.lib advapi32.lib vfw32.lib ole32.lib
DLLFILE = $(DLLDIR)gensupp.dll
DLLLIBS = $(LIBFILE) $(LIBDIR)tplotdll.lib $(LIBDIR)lexpdll.lib $(LIBDIR)sysdll.lib $(DLLDIR)g_posix.lib
!else
OBJDIR  = .\obj.nt\ 
LIBFILE = $(LIBDIR)genplot.lib
EXELIBS = $(LIBFILE) $(LIBDIR)tplot.lib $(LIBDIR)lexp.lib $(LIBDIR)sys.lib $(LIBDIR)g_posix.lib
SYSLIBS = user32.lib gdi32.lib advapi32.lib msi.lib vfw32.lib ole32.lib
DLLFILE =
DLLLIBS =
!endif

###########################################################################
MAIN   = $(OBJDIR)main.obj
SERIAL = serial.c
OBJS   = $(OBJDIR)genplot.obj    \
         $(OBJDIR)gptplot.obj  $(OBJDIR)gptaxis.obj  $(OBJDIR)gptread.obj  \
         $(OBJDIR)gptcull.obj  $(OBJDIR)gptfit.obj   $(OBJDIR)gptsubs.obj  \
         $(OBJDIR)gpttrans.obj $(OBJDIR)gptuser.obj  $(OBJDIR)userrdwr.obj \
         $(OBJDIR)gptmatrx.obj \
         $(OBJDIR)nlsfit.obj   $(OBJDIR)curfit.obj   $(OBJDIR)locmin.obj   \
	 $(OBJDIR)gpt_3d.obj   $(OBJDIR)helper.obj   \
	 $(OBJDIR)fsetup.obj   $(OBJDIR)fft2c.obj    $(OBJDIR)fft_me.obj
ICON   = genplot_nt.ico
###########################################################################
GENPLOT: nt_revtime.exe $(LIBFILE) $(DLLFILE) $(EXEFILE) $(SUPPORT_FILES)

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
nt_revtime.exe : revtime.c
	$(CC) $(WARNS) -D_CRT_SECURE_NO_DEPRECATE -Fent_revtime.exe revtime.c
	rm revtime.obj

$(LIBFILE) : $(OBJS)
	if EXIST $@ del $@
	nt_revtime GenplotRevisionDate > revision.h
	$(CC) $(CFLAGS) -c -Foserial.obj $(SERIAL)
	$(LIBMGR) /out:$@ $** serial.obj
	del serial.obj

$(INI1_FILE)		: genplot.nt.ini	; copy $** $@
$(INI2_FILE)		: genplot_.nt.ini	; copy $** $@
$(DEVFILE)		: devices.nt.dat	; copy $** $@
$(TERMKEYFILE)		: termkey.nt		; copy $** $@
$(PALETTEFILE)		: default.pal		; copy $** $@

!ifdef DLL
$(MAIN) : main.c
	$(CC) $(EXEFLAGS) -c -Fo$@ main.c

$(EXEFILE) : $(MAIN) $(EXELIBS) $(OBJDIR)main_nt.res
	$(CC) $(EXEFLAGS) -Fe$@ $** $(SYSLIBS) $(DBGLIBS)
	$(_VC_EMBED_MANIFEST)
!else
$(EXEFILE) : $(MAIN) $(EXELIBS) $(OBJDIR)main_nt.res
 	$(CC) $(EXEFLAGS) -Fe$@ $** $(SYSLIBS) $(DBGLIBS)
!endif

$(DLLDIR)gensupp.dll : $(DLLLIBS) $(SERIAL) gensupnt.def
	nt_revtime GenplotRevisionDate > revision.h
	$(CC) $(CFLAGS) -c -Foserial.obj $(SERIAL)
	$(CC) $(CFLAGS) -Fe$@ $** $(SYSLIBS)
	del serial.obj

$(OBJDIR)main_nt.res : main_nt.rc $(ICON)
	$(RC) -r -fo $(OBJDIR)main_nt.res main_nt.rc

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS) : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
          $(INCDIR)lexp.h

$(OBJDIR)main.obj      : $(INCDIR)tplot.h genplot.h
$(OBJDIR)genplot.obj   : $(INCDIR)tplot.h genplot.h gptxtrn.h gptdef.h 
$(OBJDIR)gptaxis.obj   : $(INCDIR)tplot.h           gptxtrn.h gptdef.h 
$(OBJDIR)gptcull.obj   : $(INCDIR)tplot.h           gptxtrn.h
$(OBJDIR)gptfit.obj    : $(INCDIR)tplot.h           gptxtrn.h gptdef.h nlsfit.h
$(OBJDIR)gptplot.obj   : $(INCDIR)tplot.h           gptxtrn.h gptdef.h
$(OBJDIR)gptread.obj   : $(INCDIR)tplot.h           gptxtrn.h gptdef.h 
$(OBJDIR)gptsubs.obj   : $(INCDIR)tplot.h           gptxtrn.h gptdef.h 
$(OBJDIR)gpttrans.obj  : $(INCDIR)tplot.h           gptxtrn.h
$(OBJDIR)gptmatrx.obj  : $(INCDIR)tplot.h           gptxtrn.h
$(OBJDIR)gptuser.obj   :                            gptxtrn.h gptdef.h 
$(OBJDIR)gpt_3d.obj    : $(INCDIR)tplot.h           gptxtrn.h gptdef.h
$(OBJDIR)fsetup.obj    : $(INCDIR)tplot.h           gptxtrn.h gptdef.h
$(OBJDIR)fft_me.obj    :                            gptxtrn.h
$(OBJDIR)nlsfit.obj    : $(INCDIR)tplot.h genplot.h gptxtrn.h          nlsfit.h
$(OBJDIR)userrdwr.obj  :                            gptxtrn.h
$(OBJDIR)user_aix.obj  :                            gptxtrn.h gptdef.h 

# Other dependencies, based on primary routines
$(OBJDIR)helper.obj    : helper.h
$(OBJDIR)curfit.obj    : helper.h curfit.h 
$(OBJDIR)locmin.obj    : helper.h curfit.h 
$(OBJDIR)fft2c.obj     :                   fft2c.h
$(OBJDIR)gptfit.obj    : helper.h          
$(OBJDIR)gptmatrx.obj  : helper.h          
$(OBJDIR)gptmatrx.obj  : helper.h          
$(OBJDIR)gptsubs.obj   : helper.h          
$(OBJDIR)gpttrans.obj  : helper.h          fft2c.h
$(OBJDIR)gpt_3d.obj    : helper.h
$(OBJDIR)fft_me.obj    :                   fft2c.h
$(OBJDIR)nlsfit.obj    : helper.h curfit.h
