#
#   Makefile for GENPLOT
#

include ../makewat.h

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
EXEFILE = $(EXEDIR)genplot.exe

!ifdef DLL
OBJDIR  = .\odl32\ 
LIBFILE = $(LIBDIR)gendll.lib 
EXELIBS = $(DLLDIR)gensupp.lib $(DLLDIR)g_posix.lib
SYSLIBS = -B"/NOD" DDE4MBSO.LIB OS2386.LIB
DLLFILE = $(DLLDIR)gensupp.dll
DLLLIBS = $(LIBFILE) $(LIBDIR)tplotdll.lib $(LIBDIR)lexpdll.lib $(LIBDIR)sysdll.lib $(DLLDIR)g_posix.lib
!else
OBJDIR  = .\obj32\ 
LIBFILE = $(LIBDIR)genplot.lib
EXELIBS = $(LIBFILE) $(LIBDIR)tplot.lib $(LIBDIR)lexp.lib $(LIBDIR)sys.lib $(LIBDIR)g_posix.lib
SYSLIBS =
DLLFILE =
DLLLIBS =
!endif

###########################################################################
MAIN   = $(OBJDIR)main.obj
SERIAL = serial.c
OBJS   = $(OBJDIR)genplot.obj    \
         $(OBJDIR)gptplot.obj  $(OBJDIR)gptaxis.obj  $(OBJDIR)gptread.obj  \
         $(OBJDIR)gptcull.obj  $(OBJDIR)gptfit.obj   $(OBJDIR)gptsubs.obj  \
         $(OBJDIR)gpttrans.obj $(OBJDIR)gptuser.obj  $(OBJDIR)userrdwr.obj \
         $(OBJDIR)gptmatrx.obj \
         $(OBJDIR)nlsfit.obj   $(OBJDIR)curfit.obj   $(OBJDIR)locmin.obj   \
	 $(OBJDIR)gpt_3d.obj \
	 $(OBJDIR)fsetup.obj   $(OBJDIR)fft2c.obj    $(OBJDIR)fft_me.obj
ICON   = genplot.ico
###########################################################################
GENPLOT: $(EXEFILE) $(LIBFILE) $(DLLFILE)

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(LIBFILE) : $(OBJS)
	if EXIST $@ rm $@
	$(LIBMGR) $@ /noi $**;

!ifdef DLL
$(MAIN) : main.c
	$(CC) $(CFLAGS) -Ge+ -c -Fo$@ main.c

$(EXEFILE) : $(MAIN) $(EXELIBS) main.def
	$(CC) $(CFLAGS) -Ge+ -Fe$@ $** $(SYSLIBS) $(DBGLIBS)
	addicon $(ICON) $@
!else
$(EXEFILE) : $(MAIN) $(SERIAL) $(EXELIBS) main.def
	$(CC) $(CFLAGS) -Fe$@ $** $(DBGLIBS) -B"/NOE"
	addicon $(ICON) $@
#	rc $(OBJDIR)main.res $@
!endif

$(DLLDIR)gensupp.lib : gensupp.def
	implib $@ $**

$(DLLDIR)gensupp.dll : $(DLLLIBS) $(SERIAL) gensupp.def
#	$(CC) $(CFLAGS) -Ge- -Fe$@ $** $(SYSLIBS)
	wlink NAME $@ FILE $** LIBFILE $(SYSLIBS)

$(OBJDIR)main.res : main.rc $(ICON)
	rc -r main
	mv main.res $(OBJDIR)main.res -force

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS) : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
          $(INCDIR)lexp.h

$(OBJDIR)main.obj      : $(INCDIR)tplot.h                    genplot.h
$(OBJDIR)genplot.obj   : $(INCDIR)tplot.h gptdef.h gptmain.h genplot.h
$(OBJDIR)gptcull.obj   : $(INCDIR)tplot.h          gptmain.h
$(OBJDIR)gpttrans.obj  : $(INCDIR)tplot.h          gptmain.h
$(OBJDIR)gptmatrx.obj  : $(INCDIR)tplot.h          gptmain.h
$(OBJDIR)gpt_3d.obj    : $(INCDIR)tplot.h gptdef.h gptmain.h
$(OBJDIR)gptsubs.obj   : $(INCDIR)tplot.h gptdef.h gptmain.h
$(OBJDIR)gptaxis.obj   : $(INCDIR)tplot.h gptdef.h
$(OBJDIR)gptplot.obj   : $(INCDIR)tplot.h gptdef.h gptmain.h
$(OBJDIR)gptread.obj   : $(INCDIR)tplot.h gptdef.h gptmain.h
$(OBJDIR)gptfit.obj    : $(INCDIR)tplot.h gptdef.h gptmain.h genplot.h
$(OBJDIR)nlsfit.obj    :                           gptmain.h genplot.h curfit.h
$(OBJDIR)curfit.obj    :                                               curfit.h
$(OBJDIR)locmin.obj    :                                               curfit.h
$(OBJDIR)userrdwr.obj  : 
$(OBJDIR)fsetup.obj    : $(INCDIR)tplot.h gptdef.h gptmain.h
