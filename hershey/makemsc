#
#   Makefile for HERSHEY character set data files
#

include "../makemsc.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
OBJDIR = .\obj16\ 

OEXT = o

$(DRVDIR)hdata.chr : $(DRVDIR)hercvt.exe fonts.inp *.dat
	$(DRVDIR)hercvt -i fonts.inp -o $(DRVDIR)hdata.chr

$(DRVDIR)hercvt.exe : $(OBJDIR)hercvt.$(OEXT)
	$(CC) $(COPTS) -Fe$@ $** /link /pm:vio
