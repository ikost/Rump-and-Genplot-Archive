#
#   Makefile for POSIX and low level support
#

include "../makent.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#

!ifdef DLL
OBJDIR  = .\odl.nt\ 
LIBFILE = $(LIBDIR)sysdll.lib
!else
OBJDIR  = .\obj.nt\ 
LIBFILE = $(LIBDIR)sys.lib
!endif

###########################################################################
OBJS_1   = $(OBJDIR)sys_1.obj   $(OBJDIR)sys_2.obj   $(OBJDIR)sys_3.obj
OBJS_2   = $(OBJDIR)low_io.obj  $(OBJDIR)con_nt.obj \
           $(OBJDIR)help.obj    $(OBJDIR)screen.obj  $(OBJDIR)sys_os.obj

OS2OBJ   = $(OBJDIR)ls.obj

OS2EXCPT = $(OBJDIR)matherr.obj

INCLUDES = $(INCDIR)preload.h  $(INCDIR)mytypes.h  $(INCDIR)extends.h  \
           $(INCDIR)defaults.h
###########################################################################

LIBRARY: $(INCLUDES) $(LIBFILE) SERIAL

SERIAL : 
	cd Serial.NT & $(MAKE) -$(MAKEFLAGS)


# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(INCDIR)preload.h : preload.h
	cp $** $@
	touch $@

$(INCDIR)mytypes.h : mytypes.h
	cp $** $@
	touch $@

$(INCDIR)defaults.h : defaults.h
	cp $** $@
	touch $@

$(INCDIR)extends.h : extends.h
	cp $** $@
	touch $@

$(LIBFILE) : $(OBJS_1) $(OBJS_2) $(OS2OBJ) $(OS2EXCPT)
	if EXIST $@ del $@
	$(LIBMGR) /out:$@ $**


# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS_1)            : $(INCDIR)preload.h  $(INCDIR)mytypes.h
$(OBJS_2)            : $(INCDIR)preload.h  $(INCDIR)mytypes.h
$(OBJDIR)sys_os.obj  : $(INCDIR)extends.h  $(INCDIR)defaults.h  ..\makent.h
$(OBJDIR)help.obj    : $(INCDIR)extends.h
$(OBJDIR)low_io.obj  : $(INCDIR)extends.h
$(OBJDIR)ls.obj      : $(INCDIR)extends.h
$(OBJDIR)screen.obj  : $(INCDIR)extends.h
$(OBJDIR)con_nt.obj  : $(INCDIR)extends.h
