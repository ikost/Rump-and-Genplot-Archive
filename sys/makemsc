#
#   Makefile for POSIX and low level support
#

include "../makemsc.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
OBJDIR = .\obj16\ 
# OBJDIR = 

!ifdef DLL
OEXT = odl
!else
OEXT = o
!endif

###########################################################################
OBJS     = $(OBJDIR)extends.$(OEXT) $(OBJDIR)sys.$(OEXT)    \
           $(OBJDIR)low_io.$(OEXT)  $(OBJDIR)screen.$(OEXT) \
           $(OBJDIR)help.$(OEXT)

OS2OBJ   = $(OBJDIR)posixmsc.$(OEXT)   $(OBJDIR)ls.$(OEXT)

OS2EXCPT = $(OBJDIR)matherr.$(OEXT)

INCLUDES = $(INCDIR)preload.h  $(INCDIR)mytypes.h  $(INCDIR)extends.h  \
           $(INCDIR)defaults.h
###########################################################################
!ifdef DLL
LIBRARY:  $(INCLUDES) $(LIBDIR)posixsup.lib $(DLLDIR)csupp.dll \
                      $(DLLDIR)posixsup.dll $(LIBDIR)csupp.lib
!else
LIBRARY:  $(INCLUDES) $(LIBDIR)posix.lib
!endif

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(INCDIR)preload.h : preload.h
	cp $** $@

$(INCDIR)mytypes.h : mytypes.h
	cp $** $@

$(INCDIR)defaults.h : defaults.h
	cp $** $@

$(INCDIR)extends.h : extends.h
	cp $** $@

$(LIBDIR)posix.lib : $(OBJS) $(OS2OBJ) $(OS2EXCPT)
	if EXIST $@ rm $@
	$(LIBMGR) $@ /noi $**;


# ----------------------------------------------------------- #
# -------------------  DLL Support Build -------------------- #
# ----------------------------------------------------------- #
$(LIBDIR)csupp.lib : csupp.def $(LIBDIR)cdllsupp.lib
	$(IMPLIB) $@ csupp.def
	$(LIBMGR) $@+$(LIBDIR)cdllsupp.lib;
	if EXIST $*.bak rm $*.bak

$(DLLDIR)csupp.dll : $(OS2EXCPT) csupp.def \
                     $(LIBDIR)crtlib.obj $(LIBDIR)cdllobjs.lib $(LIBDIR)os2.lib
	$(CC) $(CDLLOPTS) -Fe$@ $** /link /noe
	
$(LIBDIR)posixsup.lib : posixsup.def
	$(IMPLIB) $@ $**

$(DLLDIR)posixsup.dll : $(OBJS) $(OS2OBJ) posixsup.def \
                        $(LIBDIR)csupp.lib $(LIBDIR)crtdll.obj $(LIBDIR)os2.lib
	$(CC) $(CDLLOPTS) -Fe$@ $**


# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS)                  : $(INCDIR)preload.h  $(INCDIR)mytypes.h
$(OBJDIR)sys.$(OEXT)     : $(INCDIR)extends.h  $(INCDIR)defaults.h ..\makemsc.h
$(OBJDIR)extends.$(OEXT) : $(INCDIR)extends.h
$(OBJDIR)help.$(OEXT)    : $(INCDIR)extends.h
$(OBJDIR)low_io.$(OEXT)  : $(INCDIR)extends.h
$(OBJDIR)ls.$(OEXT)      : $(INCDIR)extends.h
$(OBJDIR)screen.$(OEXT)  : $(INCDIR)extends.h
