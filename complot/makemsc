$(OBJDIR)devini.$(OEXT)   : $(INCDIR)extends.h        
$(OBJDIR)line.$(OEXT)     : $(INCDIR)extends.h        
$(OBJDIR)hcopy.$(OEXT)    : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)ids.$(OEXT)      : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)plsystem.$(OEXT) : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)rst_comp.$(OEXT) : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)save.$(OEXT)     : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)setdev.$(OEXT)   : $(INCDIR)extends.h $(INCDIR)lexp.h io_chan.h
$(OBJDIR)sgraph.$(OEXT)   : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)symbol.$(OEXT)   : $(INCDIR)extends.h        
$(OBJDIR)tablet.$(OEXT)   : $(INCDIR)extends.h        
$(OBJDIR)pipedrv.$(OEXT)  : $(INCDIR)extends.h
$(OBJDIR)summa2.$(OEXT)   : $(INCDIR)extends.h                
$(OBJDIR)hpgl.$(OEXT)     : $(INCDIR)extends.h
$(OBJDIR)laser.$(OEXT)    : $(INCDIR)extends.h
$(OBJDIR)wpc.$(OEXT)      : $(INCDIR)extends.h
$(OBJDIR)io_chan.$(OEXT)  : $(INCDIR)extends.h

$(OBJDIR)setdev.$(OEXT)   : io_chan.h
$(OBJDIR)pipedrv.$(OEXT)  :             pipe.h
