#
#   Makefile for COMPLOT
#

include "../makemsc.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
OBJDIR = .\obj16\ 
# OBJDIR = 

!ifdef DLL
OEXT = odl
!else
OEXT = o
!endif

###########################################################################
OBJS   = $(OBJDIR)rst_comp.$(OEXT) $(OBJDIR)devini.$(OEXT)   \
         $(OBJDIR)symbol.$(OEXT)   $(OBJDIR)setdev.$(OEXT)   \
         $(OBJDIR)plsubs.$(OEXT)   $(OBJDIR)layout.$(OEXT)   \
         $(OBJDIR)plot.$(OEXT)     $(OBJDIR)fill.$(OEXT)     \
         $(OBJDIR)annote.$(OEXT)   $(OBJDIR)minmax.$(OEXT)   \
         $(OBJDIR)autosc.$(OEXT)   $(OBJDIR)velocity.$(OEXT) \
         $(OBJDIR)line.$(OEXT)     $(OBJDIR)drawing.$(OEXT)  \
         $(OBJDIR)axis.$(OEXT)     $(OBJDIR)number.$(OEXT)   \
         $(OBJDIR)ids.$(OEXT)      $(OBJDIR)cursor.$(OEXT)   \
         $(OBJDIR)scope.$(OEXT)    $(OBJDIR)sgraph.$(OEXT)   \
         $(OBJDIR)plsystem.$(OEXT) $(OBJDIR)save.$(OEXT)     \
         $(OBJDIR)hcopy.$(OEXT)    $(OBJDIR)tablet.$(OEXT)
DRVOBJ = $(OBJDIR)pipedrv.$(OEXT)  $(OBJDIR)nulldrv.$(OEXT)  \
         $(OBJDIR)io_chan.$(OEXT)  $(OBJDIR)hpgl.$(OEXT)     \
         $(OBJDIR)tektrx.$(OEXT)   $(OBJDIR)postdrv.$(OEXT)  \
         $(OBJDIR)laser.$(OEXT)    $(OBJDIR)xdriver.$(OEXT)  \
         $(OBJDIR)wpc.$(OEXT)      \
         $(OBJDIR)debug.$(OEXT)    \
         $(OBJDIR)summa2.$(OEXT)

INCLUDES = $(INCDIR)tplot.h
###########################################################################
!ifdef DLL
LIBRARY: $(INCLUDES) $(LIBDIR)tplotsup.lib $(DLLDIR)tplotsup.dll
!else
LIBRARY: $(INCLUDES) $(LIBDIR)tplot.lib
!endif

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(INCDIR)tplot.h : tplot.h
	cp $** $@

$(LIBDIR)tplot.lib : $(OBJS) $(DRVOBJ)
	if EXIST $@ rm $@
	$(LIBMGR) $@ /noi $**;


# ----------------------------------------------------------- #
# -------------------  DLL Support Build -------------------- #
# ----------------------------------------------------------- #
$(LIBDIR)tplotsup.lib : tplotsup.def
	$(IMPLIB) $@ $**

$(DLLDIR)tplotsup.dll : $(OBJS) $(DRVOBJ) tplotsup.def \
                        $(LIBDIR)csupp.lib $(LIBDIR)posixsup.lib $(LIBDIR)lexpsupp.lib \
                        $(LIBDIR)crtdll.obj $(LIBDIR)os2.lib 
	$(CC) $(CDLLOPTS) -Fe$@ $**


# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS) $(DRVOBJ) : $(INCDIR)mytypes.h complot.h
$(OBJS)           : $(INCDIR)tplot.h   plotdefs.h

$(OBJDIR)annote.$(OEXT)   : $(INCDIR)extends.h $(INCDIR)lexp.h 
$(OBJDIR)autosc.$(OEXT)   : $(INCDIR)extends.h        
$(OBJDIR)axis.$(OEXT)     : $(INCDIR)extends.h        
