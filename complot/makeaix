#
#   Makefile for COMPLOT
#
# this file goes in clib/complot

include ../makeaix.h

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#

###########################################################################
# OBJ DRVOBJ are the routines which are linked directly into the library
###########################################################################
OBJS   = rst_comp.o devini.o   symbol.o   setdev.o   \
         plsubs.o   layout.o   plot.o     fill.o     \
         annote.o   minmax.o   autosc.o   velocity.o \
         line.o     drawing.o  axis.o     number.o   \
         ids.o      cursor.o   scope.o    sgraph.o   \
         plsystem.o save.o     hcopy.o    tablet.o   \
	 3d.o       fixplt.o   find_drv.o

DRVOBJ = pipedrv.o  nulldrv.o  io_chan.o  hpgl.o     \
         tektrx.o   postdrv.o  laser.o    xdriver.o  \
         wpc.o      xmldrv.o   debug.o    summa2.o

###########################################################################
ALL:       LIBRARY XSLAVE

LIBRARY:   $(INCDIR)tplot.h $(LIBDIR)tplot.a
XSLAVE:    $(DRVDIR)xslave.drv

# Now, get into the actual creation commands
$(INCDIR)tplot.h : tplot.h
	cp tplot.h $(INCDIR)tplot.h

$(LIBDIR)tplot.a : $(OBJS) $(DRVOBJ)
	$(LIBMGR) $(LIBDIR)tplot.a $(OBJS) $(DRVOBJ)
	ranlib $(LIBDIR)tplot.a
	@echo 'Complot LIBRARY MADE'

$(DRVDIR)xslave.drv: xslavex.o xslave.o
	$(XCC) -o $(DRVDIR)xslave.drv xslave.o xslavex.o $(XSYSLIBS) $(SYSLIBS)

xslavex.o: xslavex.c xslavex.h xslavexp.h
	$(XCC) $(XFLAGS) -c xslavex.c 

xslave.o:  xslave.c  xslavex.h
	$(XCC) $(XFLAGS) -c xslave.c

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS)    : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
             complot.h tplot.h plotdefs.h
$(DRVOBJ)  : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
             complot.h

find_drv.o : drvclass.h
laser.o    : drvclass.h

debug.o    : io_chan.h
xmldrv.o   : io_chan.h
hpgl.o     : io_chan.h
io_chan.o  : io_chan.h
postdrv.o  : io_chan.h
setdev.o   : io_chan.h
tektrx.o   : io_chan.h
wpc.o      : io_chan.h

annote.o   : $(INCDIR)lexp.h
hcopy.o    : $(INCDIR)lexp.h
ids.o      : $(INCDIR)lexp.h
plsystem.o : $(INCDIR)lexp.h
rst_comp.o : $(INCDIR)lexp.h
save.o     : $(INCDIR)lexp.h
setdev.o   : $(INCDIR)lexp.h
sgraph.o   : $(INCDIR)lexp.h

pipedrv.o  : pipe.h

# Some UNIX are specific about POSIX compliance.  popen/pclose are not defined
# except via the extended compiler.  Specifically define compile route here
annote.o  : annote.c
	$(ECC) $(EFLAGS) -c annote.c

pipedrv.o  : pipedrv.c
	$(ECC) $(EFLAGS) -c pipedrv.c

io_chan.o  : io_chan.c
	$(ECC) $(EFLAGS) -c io_chan.c

laser.o    : laser.c
	$(ECC) $(EFLAGS) -c laser.c
