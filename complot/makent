#
#   Makefile for TPLOT
#

include "../makent.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#

!ifdef DLL
OBJDIR  = .\odl.nt\ 
LIBFILE = $(LIBDIR)tplotdll.lib
!else
OBJDIR  = .\obj.nt\ 
LIBFILE = $(LIBDIR)tplot.lib
!endif

###########################################################################
OBJS   = $(OBJDIR)rst_comp.obj $(OBJDIR)devini.obj   \
         $(OBJDIR)symbol.obj   $(OBJDIR)setdev.obj   \
         $(OBJDIR)plsubs.obj   $(OBJDIR)layout.obj   \
         $(OBJDIR)plot.obj     $(OBJDIR)fill.obj     \
         $(OBJDIR)annote.obj   $(OBJDIR)minmax.obj   \
         $(OBJDIR)autosc.obj   $(OBJDIR)velocity.obj \
         $(OBJDIR)line.obj     $(OBJDIR)drawing.obj  \
         $(OBJDIR)axis.obj     $(OBJDIR)number.obj   \
         $(OBJDIR)ids.obj      $(OBJDIR)cursor.obj   \
         $(OBJDIR)scope.obj    $(OBJDIR)sgraph.obj   \
         $(OBJDIR)plsystem.obj $(OBJDIR)save.obj     \
         $(OBJDIR)hcopy.obj    $(OBJDIR)tablet.obj   \
	 $(OBJDIR)3d.obj       $(OBJDIR)fixplt.obj   \
         $(OBJDIR)find_drv.obj
DRVOBJ = $(OBJDIR)pipedrv.obj  $(OBJDIR)nulldrv.obj  \
         $(OBJDIR)io_chan.obj  $(OBJDIR)hpgl.obj     \
         $(OBJDIR)tektrx.obj   $(OBJDIR)postdrv.obj  \
         $(OBJDIR)laser.obj    $(OBJDIR)xdriver.obj  \
         $(OBJDIR)wpc.obj      $(OBJDIR)xmldrv.obj   \
         $(OBJDIR)debug.obj			     \
         $(OBJDIR)summa2.obj

INCLUDES = $(INCDIR)tplot.h

SUPPORT  = $(DRVDIR)colormap.dat
###########################################################################

LIBRARY: $(INCLUDES) $(LIBFILE) $(SUPPORT)

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(DRVDIR)colormap.dat : colormap.dat
	cp $** $@
	touch $@

$(INCDIR)tplot.h : tplot.h
	cp $** $@
	touch $@

$(LIBFILE) : $(OBJS) $(DRVOBJ)
	if EXIST $@ del $@
	$(LIBMGR) /out:$@ $**


# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS)    : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
             complot.h tplot.h plotdefs.h
$(DRVOBJ)  : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
             complot.h

$(OBJDIR)find_drv.obj : drvclass.h
$(OBJDIR)laser.obj    : drvclass.h

$(OBJDIR)debug.obj    : io_chan.h
$(OBJDIR)xmldrv.obj   : io_chan.h
$(OBJDIR)hpgl.obj     : io_chan.h
$(OBJDIR)io_chan.obj  : io_chan.h
$(OBJDIR)postdrv.obj  : io_chan.h
$(OBJDIR)setdev.obj   : io_chan.h
$(OBJDIR)tektrx.obj   : io_chan.h
$(OBJDIR)wpc.obj      : io_chan.h

$(OBJDIR)annote.obj   : $(INCDIR)lexp.h 
$(OBJDIR)hcopy.obj    : $(INCDIR)lexp.h 
$(OBJDIR)ids.obj      : $(INCDIR)lexp.h 
$(OBJDIR)plsystem.obj : $(INCDIR)lexp.h 
$(OBJDIR)rst_comp.obj : $(INCDIR)lexp.h 
$(OBJDIR)save.obj     : $(INCDIR)lexp.h 
$(OBJDIR)setdev.obj   : $(INCDIR)lexp.h
$(OBJDIR)sgraph.obj   : $(INCDIR)lexp.h 

$(OBJDIR)pipedrv.obj  : pipe.h
