#
#   Makefile for LEXP
#

include "../makent.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#

!ifdef DLL
OBJDIR  = .\odl.nt\ 
LIBFILE = $(LIBDIR)lexpdll.lib
!else
OBJDIR  = .\obj.nt\ 
LIBFILE = $(LIBDIR)lexp.lib
!endif

###########################################################################
OBJS    = $(OBJDIR)lexp.obj     $(OBJDIR)lexp2.obj   \
          $(OBJDIR)system.obj   $(OBJDIR)help.obj    \
          $(OBJDIR)gvcode.obj   $(OBJDIR)gvcalc.obj  \
          $(OBJDIR)gvparse.obj  $(OBJDIR)gvsolve.obj \
          $(OBJDIR)gvmath.obj	$(OBJDIR)FermiIntegral.obj
MERSENNE_OBJS = ../mtwist-1.1/$(OBJDIR)mtwist.obj ../mtwist-1.1/$(OBJDIR)randistrs.obj 

INCLUDES = $(INCDIR)lexp.h
###########################################################################

LIBRARY: MERSENNE_ $(INCLUDES) $(LIBFILE)

MERSENNE_:
	cd ..\mtwist-1.1 & $(MAKE) -f makent -L

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(INCDIR)lexp.h : lexp.h
	cp $** $@
	touch $@

$(LIBFILE) : $(OBJS) $(MERSENNE_OBJS)
	if EXIST $@ del $@
	$(LIBMGR) /out:$@ $**


# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS)            : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
                     $(INCDIR)lexp.h
$(OBJDIR)system.obj : $(INCDIR)defaults.h
$(OBJDIR)gvcalc.obj : gvdefs.h FermiIntegral.h
$(OBJDIR)gvcode.obj : gvdefs.h
$(OBJDIR)gvparse.obj: gvdefs.h
$(OBJDIR)FermiIntegral.obj : FermiIntegral.h
