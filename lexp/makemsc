#
#   Makefile for LEXP
#

include "../makemsc.h"

#==============================================================#
# Specify directories for putting files generated by this Make #
# Note, space required at the end of lines with trailing \     #
#==============================================================#
OBJDIR = .\obj16\ 
# OBJDIR = 

!ifdef DLL
OEXT = odl
!else
OEXT = o
!endif

###########################################################################
OBJS    = $(OBJDIR)lexp.$(OEXT)     $(OBJDIR)lexp2.$(OEXT)   \
          $(OBJDIR)system.$(OEXT)   $(OBJDIR)help.$(OEXT)    \
          $(OBJDIR)gvcode.$(OEXT)   $(OBJDIR)gvcalc.$(OEXT)  \
          $(OBJDIR)gvparse.$(OEXT)  $(OBJDIR)gvsolve.$(OEXT) \
          $(OBJDIR)gvmath.$(OEXT)

INCLUDES = $(INCDIR)lexp.h
###########################################################################
!ifdef DLL
LIBRARY: $(INCLUDES) $(LIBDIR)lexpsupp.lib $(DLLDIR)lexpsupp.dll
!else
LIBRARY: $(INCLUDES) $(LIBDIR)lexp.lib
!endif

# ----------------------------------------------------------- #
# ------------------- Basic Library Build ------------------- #
# ----------------------------------------------------------- #
$(INCDIR)lexp.h : lexp.h
	cp $** $@

$(LIBDIR)lexp.lib : $(OBJS)
	if EXIST $@ rm $@
	$(LIBMGR) $@ /noi $**;


# ----------------------------------------------------------- #
# -------------------  DLL Support Build -------------------- #
# ----------------------------------------------------------- #
$(LIBDIR)lexpsupp.lib : lexpsupp.def
	$(IMPLIB) $@ $**

$(DLLDIR)lexpsupp.dll : $(OBJS) lexpsupp.def \
                        $(LIBDIR)csupp.lib  $(LIBDIR)posixsup.lib \
                        $(LIBDIR)crtdll.obj $(LIBDIR)os2.lib 
	$(CC) $(CDLLOPTS) -Fe$@ $**

# ----------------------------------------------------------- #
# -------------- Include File Dependencies ------------------ #
# ----------------------------------------------------------- #
$(OBJS)            : $(INCDIR)preload.h $(INCDIR)mytypes.h $(INCDIR)extends.h \
                     $(INCDIR)lexp.h
$(OBJDIR)system.$(OEXT) : $(INCDIR)defaults.h
$(OBJDIR)gvcalc.$(OEXT) : gvdefs.h
$(OBJDIR)gvcode.$(OEXT) : gvdefs.h
$(OBJDIR)gvparse.$(OEXT): gvdefs.h
